{
    "name": "pomodoro-logger-enhanced",
    "version": "0.0.0-semantically-released",
    "description": "Pomodoro Logger -- When a time logger meets Pomodoro and Kanban board. This is an enhanced edition, as the original version has been archived.",
    "main": "./dist/main.js",
    "scripts": {
        "build-main": "cross-env NODE_ENV=production webpack --config webpack.main.prod.config.js",
        "build-renderer": "cross-env NODE_ENV=production webpack --config webpack.renderer.prod.config.js",
        "prebuild": "node -e \"require('fs').rmSync('./dist',{recursive:true,force:true})\"",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "build": "tsc --noEmit -p tsconfig.json && concurrently \"yarn:build-main\" \"yarn:build-renderer\"",
        "start-renderer-dev": "cross-env NODE_ENV=development webpack serve --config webpack.renderer.dev.config.js",
        "start-main-dev": "cross-env webpack --config webpack.main.config.js",
        "start-electron": "electron .",
        "start": "concurrently \"yarn:start-main-dev\" \"yarn:start-renderer-dev\"",
        "prestart:prod": "yarn build",
        "start:prod": "electron .",
        "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,js}\"",
        "test": "jest --forceExit",
        "test:coverage": "yarn test --coverage",
        "test:debug": "jest --forceExit --detectOpenHandles --runInBand",
        "test:watch": "jest --watch",
        "posttest": "node -e \"require('fs').rmSync('./.local/test',{recursive:true,force:true})\"",
        "pack": "yarn build && electron-builder --dir",
        "dist-win": "yarn build && electron-builder --windows -p onTagOrDraft",
        "dist-mac": "yarn build && electron-builder --mac -p onTagOrDraft",
        "dist-linux": "yarn build && electron-builder --linux -p onTagOrDraft",
        "dist-all": "yarn build && electron-builder -mwl",
        "release": "semantic-release",
        "prepare": "husky",
        "postinstall": "electron-builder install-app-deps"
    },
    "lint-staged": {
        "{src,test,mocks}/**/*.{js,ts,tsx,json,css,scss,md}": [
            "prettier --config ./.prettierrc --write"
        ],
        "{src,test,mocks}/**/*.{ts,tsx}": [
            "eslint --fix"
        ]
    },
    "build": {
        "productName": "Pomodoro Logger Enhanced",
        "appId": "com.github.nightzed.pomodoro-logger-enhanced",
        "publish": {
            "provider": "github",
            "owner": "nightzed",
            "repo": "PomodoroLogger-Enhanced",
            "releaseType": "release"
        },
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "arm64",
                        "x64"
                    ]
                }
            ],
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "extendInfo": {
                "NSAppleEventsUsageDescription": "Please allow access to script browser applications to detect the current URL when triggering instant lookup."
            },
            "notarize": true
        },
        "directories": {
            "output": "release"
        },
        "compression": "maximum",
        "asar": true,
        "afterPack": "build/afterPack.js",
        "electronLanguages": [
            "en-US",
            "zh-CN"
        ],
        "files": [
            "dist/**/*",
            "package.json",
            "!**/*.map",
            "!**/{.git,.github,.circleci,.vscode,__mocks__,test,tests,__tests__,coverage,release,webpack-visualization}",
            "!.local{,/**}",
            "!docs{,/**}",
            "!src{,/**}",
            "!public{,/**}",
            "!mocks{,/**}",
            "!build{,/**}",
            "!scripts{,/**}",
            "!{.babelrc,.eslintrc*,.prettierrc,.npmrc,.yarnrc,.releaserc.json,commitlint.config.js,eslint.config.js,jest.config.js,tsconfig.json,webpack.*.js,CHANGELOG.md,README*.md,LICENSE,junit.xml,*.log}",
            "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
            "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
            "!**/node_modules/*.d.ts",
            "!**/node_modules/.bin",
            "!**/*.{o,h,cc,cpp,cxx,gyp,gypi,ipdb,iobj,vcxproj,filters,tlog,recipe,lastbuildstate,obj,res,pdb,exp,ilk}",
            "!**/node_modules/node-gyp{,/**}",
            "!**/node_modules/better-sqlite3/{deps,src,build}{,/**}",
            "!**/node_modules/better-sqlite3/binding.gyp",
            "!**/node_modules/get-windows/{Sources,build,test,ava.config.js,binding.gyp}",
            "!**/node_modules/get-windows/lib/binding/napi-*-darwin-*{,/**}",
            "!**/node_modules/get-windows/lib/binding/napi-*-linux-*{,/**}",
            "!**/node_modules/electron-updater/{.github,test,examples,*.md}",
            "!**/node_modules/electron-updater/out/**/*.map",
            "!**/node_modules/electron-updater/out/**/*.d.ts",
            "!**/node_modules/js-yaml/dist{,/**}"
        ],
        "asarUnpack": [
            "**/*.node",
            "**/node_modules/get-windows/main"
        ],
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico"
        },
        "nsis": {
            "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "differentialPackage": false
        },
        "linux": {
            "target": [
                "deb",
                "AppImage",
                "rpm"
            ]
        },
        "deb": {
            "artifactName": "${name}_${version}_${arch}.${ext}"
        },
        "appImage": {
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
        },
        "rpm": {
            "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
        }
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:NightZed/PomodoroLogger-Enhanced.git"
    },
    "author": {
        "name": "Zixuan Chen",
        "email": "remch183@outlook.com"
    },
    "license": "LGPL-3.0-or-later",
    "bugs": {
        "url": "https://github.com/NightZed/PomodoroLogger-Enhanced/issues"
    },
    "devDependencies": {
        "@ant-design/icons": "^6",
        "@babel/core": "^8.0.9",
        "@babel/plugin-transform-runtime": "^8.0.6",
        "@babel/preset-env": "^8.0.7",
        "@babel/preset-react": "^8.0.1",
        "@babel/preset-typescript": "^8.0.7",
        "@babel/runtime": "^8.0.7",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.2",
        "@eslint/js": "^10.0.1",
        "@hello-pangea/dnd": "^18.0.1",
        "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
        "@redux-devtools/extension": "^4.0.0",
        "@reduxjs/toolkit": "^2.13.0",
        "@semantic-release/github": "^12.0.10",
        "@svgr/webpack": "^8.1.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.0",
        "@types/better-sqlite3": "^9.6.0",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.27",
        "@types/node": "^24.19.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@types/webpack-env": "^1.18.8",
        "@typescript/native": "npm:typescript@^7.0.2",
        "antd": "^6",
        "babel-jest": "^30.5.2",
        "babel-loader": "^10.1.1",
        "classnames": "^2.5.1",
        "concurrently": "^10.0.6",
        "conventional-changelog-conventionalcommits": "9.3.1",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.5",
        "dayjs": "^1.11.13",
        "dompurify": "^3.4.17",
        "echarts": "^6.1.0",
        "echarts-for-react": "^3.0.6",
        "electron": "^44.9.3",
        "electron-builder": "^26.18.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "html-webpack-plugin": "^5.6.8",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jest-junit": "^17.0.0",
        "lint-staged": "^17.6.0",
        "lodash-es": "^4.18.1",
        "marked": "^18.1.1",
        "nanoid": "^6.0.2",
        "prettier": "^3.9.10",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-hotkeys-hook": "^5.3.3",
        "react-is": "^19.3.1",
        "react-redux": "9.3.0",
        "react-refresh": "^0.19.0",
        "redux": "^5.0.1",
        "redux-thunk": "^3.1.0",
        "sass": "^1.106.1",
        "sass-loader": "^17.0.1",
        "semantic-release": "^25.0.9",
        "source-map-loader": "^5.0.0",
        "style-loader": "^4.0.0",
        "styled-components": "^6.6.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.72.0",
        "webpack": "^5.112.1",
        "webpack-bundle-analyzer": "^5.4.0",
        "webpack-cli": "^7.2.3",
        "webpack-dev-server": "^6.1.0",
        "webpack-merge": "^6.0.1",
        "wordcloud": "^1.2.3"
    },
    "dependencies": {
        "better-sqlite3": "^13.0.0",
        "electron-updater": "^6.8.11",
        "get-windows": "9.3.0"
    },
    "resolutions": {
        "node-ipc": "9.1.1",
        "@types/react": "19.3.0"
    },
    "sideEffects": [
        "**/*.css",
        "**/*.scss",
        "./src/main/**/*",
        "./src/config.ts",
        "./src/renderer/echartsSetup.ts",
        "**/electron"
    ],
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
