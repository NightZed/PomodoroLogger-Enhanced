{
    "name": "pomodoro-logger-enhanced",
    "version": "0.0.0-semantically-released",
    "description": "Pomodoro Logger -- When a time logger meets Pomodoro and Kanban board. This is an enhanced edition, as the original version has been archived.",
    "main": "./dist/main.js",
    "scripts": {
        "build-main": "cross-env NODE_ENV=production webpack --config webpack.main.prod.config.js",
        "build-renderer": "cross-env NODE_ENV=production webpack --config webpack.renderer.prod.config.js",
        "prebuild": "node -e \"require('fs').rmSync('./dist',{recursive:true,force:true})\"",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "build": "tsc --noEmit -p tsconfig.json && concurrently \"yarn:build-main\" \"yarn:build-renderer\"",
        "start-renderer-dev": "cross-env NODE_ENV=development webpack serve --config webpack.renderer.dev.config.js",
        "start-main-dev": "cross-env webpack --config webpack.main.config.js",
        "start-electron": "electron .",
        "start": "concurrently \"yarn:start-main-dev\" \"yarn:start-renderer-dev\"",
        "prestart:prod": "yarn build",
        "start:prod": "electron .",
        "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
        "test": "jest --forceExit --detectOpenHandles",
        "posttest": "node -e \"require('fs').rmSync('./__test__db',{recursive:true,force:true})\"",
        "pack": "yarn build && electron-builder --dir",
        "dist-win": "yarn build && electron-builder --windows -p onTagOrDraft",
        "dist-mac": "yarn build && electron-builder --mac -p onTagOrDraft",
        "dist-linux": "yarn build && electron-builder --linux -p onTagOrDraft",
        "dist-all": "yarn build && electron-builder -mwl",
        "release": "semantic-release",
        "postinstall": "electron-builder install-app-deps",
        "style": "styleguidist server",
        "style-pack": "webpack --config webpack.style.js"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint --edit $HUSKY_GIT_PARAMS",
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "{src,test,mocks}/**/*.{js,ts,tsx,json,css,scss,md}": [
            "prettier --config ./.prettierrc --write"
        ],
        "{src,test,mocks}/**/*.{ts,tsx}": [
            "eslint --fix"
        ]
    },
    "build": {
        "productName": "Pomodoro Logger Enhanced",
        "appId": "com.github.nightzed.pomodoro-logger-enhanced",
        "publish": {
            "provider": "github",
            "owner": "nightzed",
            "repo": "PomodoroLogger-Enhanced",
            "releaseType": "release"
        },
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                "zip",
                "dmg"
            ],
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "extendInfo": {
                "NSAppleEventsUsageDescription": "Please allow access to script browser applications to detect the current URL when triggering instant lookup."
            },
            "notarize": true
        },
        "directories": {
            "output": "release"
        },
        "compression": "maximum",
        "asar": true,
        "electronLanguages": [
            "en-US",
            "zh-CN"
        ],
        "files": [
            "dist/**/*",
            "package.json",
            "!**/*.map",
            "!**/{.git,.github,.circleci,.vscode,__mocks__,test,tests,__tests__,__test__db,coverage,release,webpack-visualization}",
            "!db{,/**}",
            "!db-bk{,/**}",
            "!screenshots{,/**}",
            "!src{,/**}",
            "!public{,/**}",
            "!mocks{,/**}",
            "!build{,/**}",
            "!scripts{,/**}",
            "!{.babelrc,.eslintrc*,.prettierrc,.npmrc,.yarnrc,.releaserc.json,codecov.yml,commitlint.config.js,eslint.config.js,jest.config.js,styleguide.config.js,tsconfig.json,webpack.*.js,CHANGELOG.md,README*.md,LICENSE,junit.xml,*.log}",
            "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
            "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
            "!**/node_modules/*.d.ts",
            "!**/node_modules/.bin",
            "!**/*.{o,h,cc,cpp,cxx,gyp,gypi,ipdb,iobj,vcxproj,filters,tlog,recipe,lastbuildstate,obj,res,pdb,exp,ilk}",
            "!**/node_modules/node-gyp{,/**}",
            "!**/node_modules/@mapbox{,/**}",
            "!**/node_modules/active-win/{Sources,build,test,ava.config.js,binding.gyp}",
            "!**/node_modules/active-win/lib/binding/napi-*-darwin-*{,/**}",
            "!**/node_modules/active-win/lib/binding/napi-*-linux-*{,/**}",
            "!**/node_modules/electron-updater/{.github,test,examples,*.md}",
            "!**/node_modules/electron-updater/out/**/*.map",
            "!**/node_modules/electron-updater/out/**/*.d.ts",
            "!**/node_modules/js-yaml/dist{,/**}"
        ],
        "asarUnpack": [
            "**/*.node",
            "**/node_modules/active-win/main"
        ],
        "win": {
            "target": "nsis"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "differentialPackage": false
        },
        "linux": {
            "target": "deb",
            "files": [
                "!**/node_modules/active-win/lib/binding/napi-*-darwin-*{,/**}",
                "!**/node_modules/active-win/lib/binding/napi-*-win32-*{,/**}"
            ]
        }
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:NightZed/PomodoroLogger-Enhanced.git"
    },
    "author": {
        "name": "Zixuan Chen",
        "email": "remch183@outlook.com"
    },
    "license": "LGPL-3.0-or-later",
    "bugs": {
        "url": "https://github.com/NightZed/PomodoroLogger-Enhanced/issues"
    },
    "homepage": "https://github.com/NightZed/PomodoroLogger-Enhanced",
    "devDependencies": {
        "@babel/core": "^7.4.5",
        "@babel/plugin-proposal-class-properties": "^7.4.4",
        "@babel/plugin-proposal-optional-chaining": "^7.10.1",
        "@babel/plugin-transform-runtime": "^7.5.5",
        "@babel/polyfill": "^7.10.1",
        "@babel/preset-env": "^7.4.5",
        "@babel/preset-react": "^7.0.0",
        "@babel/preset-typescript": "^7.8.3",
        "@babel/runtime": "^7.5.5",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@eslint/js": "^9.39.5",
        "@hot-loader/react-dom": "^16.8.6",
        "@semantic-release/github": "^12.0.9",
        "@svgr/webpack": "^8.1.0",
        "@types/classnames": "^2.2.9",
        "@types/echarts": "^4.1.9",
        "@types/enzyme": "^3.10.1",
        "@types/enzyme-adapter-react-16": "^1.0.5",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.14.135",
        "@types/marked": "^4.0.2",
        "@types/nedb": "^1.8.7",
        "@types/node": "^22.20.4",
        "@types/react": "^16.8.18",
        "@types/react-beautiful-dnd": "^11.0.3",
        "@types/react-dom": "^16.8.4",
        "@types/react-hot-loader": "^4.1.0",
        "@types/react-redux": "^7.0.9",
        "@types/react-test-renderer": "^16.8.2",
        "@types/redux-thunk": "^2.1.0",
        "@types/shortid": "^0.0.29",
        "@types/styled-components": "^5.1.24",
        "@types/webpack-env": "^1.18.8",
        "antd": "^3.19.7",
        "babel-loader": "^10.1.1",
        "classnames": "^2.2.6",
        "codecov": "^3.5.0",
        "concurrently": "^10.0.5",
        "conventional-changelog-conventionalcommits": "9.3.1",
        "copy-webpack-plugin": "^14.0.0",
        "cross-env": "^10.1.0",
        "css-loader": "^7.1.5",
        "deox": "^2.1.0",
        "echarts": "^4.5.0",
        "echarts-for-react": "^2.0.15-beta.1",
        "electron": "^39.8.10",
        "electron-builder": "^26.15.3",
        "enzyme": "^3.10.0",
        "enzyme-adapter-react-16": "^1.14.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "html-webpack-plugin": "^5.6.8",
        "husky": "^2.3.0",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jest-junit": "^17.0.0",
        "lint-staged": "^17.5.1",
        "lodash-es": "^4.17.21",
        "marked": "^4.0.10",
        "moment": "^2.29.4",
        "nedb": "^1.8.0",
        "node-gyp": "^9.0.0",
        "prettier": "^2.0.2",
        "prop-types": "^15.7.2",
        "react": "^16.8.6",
        "react-beautiful-dnd": "^12.2.0",
        "react-docgen-typescript": "^1.16.5",
        "react-docgen-typescript-loader": "^3.7.2",
        "react-dom": "^16.8.6",
        "react-hot-keys": "^2.4.4",
        "react-hot-loader": "^4.8.8",
        "react-redux": "^7.0.3",
        "react-stack-grid": "^0.7.1",
        "react-styleguidist": "^11.0.8",
        "react-test-renderer": "^16.8.6",
        "react-trend": "zxch3n/react-trend",
        "redux": "^4.0.1",
        "redux-devtools-extension": "^2.13.5",
        "redux-thunk": "^2.3.0",
        "sass": "^1.104.1",
        "sass-loader": "^17.0.1",
        "semantic-release": "^25.0.9",
        "shortid": "^2.2.14",
        "source-map-loader": "^5.0.0",
        "style-loader": "^4.0.0",
        "styled-components": "^5.3.3",
        "ts-jest": "^29.4.13",
        "ts-loader": "^9.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1",
        "webpack": "^5.111.1",
        "webpack-bundle-analyzer": "^5.4.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.2.6",
        "webpack-merge": "^6.0.1",
        "wordcloud": "^1.1.0",
        "worker-loader": "^3.0.8"
    },
    "dependencies": {
        "@electron/remote": "^2.1.3",
        "active-win": "8.2.1",
        "electron-updater": "^6.8.9"
    },
    "resolutions": {
        "node-ipc": "9.1.1"
    },
    "sideEffects": [
        "**/*.css",
        "**/*.scss",
        "./src/main/**/*",
        "./src/config.ts",
        "./src/renderer/echartsSetup.ts",
        "**/electron"
    ],
    "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
